# Runtime mode: development, test, staging, or production.
NODE_ENV=development
ENVIRONMENT_ID=development

# API bind settings. HOST should remain 0.0.0.0 on Railway.
HOST=0.0.0.0
PORT=3000

# Structured log severity: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info

# Server-only MongoDB Atlas settings. Never prefix these with VITE_ or expose them to the frontend.
MONGODB_URI=REPLACE_WITH_NONPRODUCTION_MONGODB_URI
MONGODB_DATABASE=booknowtech_development

# Immutable source/deployment identifier supplied by CI or Railway.
BUILD_VERSION=local

# Canonical fallback root. Railway staging uses staging.booknowtech.com; production uses booknowtech.com.
BOOKING_ROOT_DOMAIN=booknowtech.com
VITE_BOOKING_ROOT_DOMAIN=booknowtech.com
VITE_BUILD_VERSION=local

# Centralized Business Hub origin and temporary PR 2 rollout control.
ADMIN_ORIGIN=http://localhost:4173
TENANT_ADMIN_ENABLED=false

# OpenAPI is allowed only outside production.
OPENAPI_ENABLED=true

# Browser-visible API origin. This is not a secret.
VITE_API_BASE_URL=/api

# Worker-only transactional email configuration. Keep the token server-side.
TRANSACTIONAL_EMAIL_PROVIDER=postmark
TRANSACTIONAL_EMAIL_TOKEN=REPLACE_WITH_NONPRODUCTION_POSTMARK_SERVER_TOKEN
TRANSACTIONAL_EMAIL_FROM=appointments@example.com
POSTMARK_SERVER_ID=REPLACE_WITH_NONPRODUCTION_POSTMARK_SERVER_ID

# API and worker must share the appointment token secret within one environment only.
PUBLIC_APPOINTMENT_TOKEN_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES

# API-only rate-limit HMAC secret.
RATE_LIMIT_KEY_SECRET=REPLACE_WITH_DIFFERENT_32_OR_MORE_RANDOM_BYTES
MONITORING_TOKEN=bnt_monitoring_development_REPLACE_WITH_48_OR_MORE_RANDOM_BYTES

# Stripe Connect Foundation. Keep all values server-side and environment-specific.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_NONPRODUCTION_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_NONPRODUCTION_STRIPE_PUBLISHABLE_KEY
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_REPLACE_WITH_PLATFORM_ENDPOINT_SECRET
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_WITH_CONNECT_ENDPOINT_SECRET
STRIPE_CONNECT_COUNTRY=US
BOOKNOWTECH_CONNECT_TERMS_VERSION=connect-v1
BOOKNOWTECH_CONNECT_TERMS_TEXT_SHA256=REPLACE_WITH_64_CHARACTER_LOWERCASE_SHA256
STRIPE_PAYMENTS_FOUNDATION_ENABLED=false
STRIPE_PAYMENT_EXECUTION_ENABLED=false
STRIPE_ACCOUNT_READINESS_MAX_AGE_SECONDS=900
BOOKNOWTECH_PAYMENT_TERMS_VERSION=payments-v1
BOOKNOWTECH_PAYMENT_TERMS_TEXT_SHA256=REPLACE_WITH_64_CHARACTER_LOWERCASE_SHA256
PAYMENT_IP_HASH_SECRET=REPLACE_WITH_DIFFERENT_32_OR_MORE_RANDOM_BYTES
CHECKOUT_RECOVERY_TOKEN_SECRET=REPLACE_WITH_ANOTHER_32_OR_MORE_RANDOM_BYTES
