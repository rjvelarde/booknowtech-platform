# Runtime mode: development, test, staging, or production.
NODE_ENV=development

# API bind settings. HOST should remain 0.0.0.0 on Railway.
HOST=0.0.0.0
PORT=3000

# Structured log severity: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info

# Server-only MongoDB Atlas settings. Never prefix these with VITE_ or expose them to the frontend.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=booknowtech_development

# Immutable source/deployment identifier supplied by CI or Railway.
BUILD_VERSION=local

# OpenAPI is allowed only outside production.
OPENAPI_ENABLED=true

# Browser-visible API origin. This is not a secret.
VITE_API_BASE_URL=http://localhost:3000
