{
  "name": "@booknowtech/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "start": "sirv dist --single --host 0.0.0.0 --port ${PORT:-4173}",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run integration --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@booknowtech/shared": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sirv-cli": "3.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
